// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  /// scrypt hash (salt:hex) — null for accounts without credentials sign-in
  passwordHash String?
  posts        Post[]
  presets      GlassPreset[]
  backgrounds  BackgroundImage[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
}

/// Saved glass configurations from the Glass Lab.
/// userId = null → public preset (visible/deletable by guests);
/// userId set  → owned by that user (private).
model GlassPreset {
  id        String   @id @default(cuid())
  name      String
  /// Full GlassConfig JSON (see src/lib/glass/presets.ts)
  config    String
  /// Optional cover snapshot (data URL) generated client-side on save;
  /// null for legacy rows → UI falls back to the tint gradient swatch.
  cover     String?
  /// Starred by the viewer. Public presets can be favorited by anyone
  /// (mirrors the open-delete rule); private ones only by their owner.
  favorite  Boolean  @default(false)
  owner     User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([userId])
}

/// Custom stage backgrounds uploaded from the Glass Lab.
/// Ownership mirrors GlassPreset: userId = null → public (guest upload,
/// openly listable/deletable); userId set → owned by that user (private).
model BackgroundImage {
  id        String   @id @default(cuid())
  name      String
  /// Sniffed (not client-asserted) image mime type: image/png|jpeg|webp|gif
  mimeType  String
  /// Byte length of `data`, kept denormalized for list endpoints
  size      Int
  /// Raw image bytes (SQLite BLOB) — served via /api/backgrounds/[id]/raw
  data      Bytes
  owner     User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}